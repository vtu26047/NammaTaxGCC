<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Detects changes to property fields that may affect property tax.</description>
        <name>Check_Tax_Impacting_Change</name>
        <label>Check Tax Impacting Change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Tax_Impacting_Change</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Built_up_Area__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Number_of_Floors__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Usage_Type__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreatePropertyChange</targetReference>
            </connector>
            <label>Tax Impacting Change</label>
        </rules>
    </decisions>
    <description>Detects tax-impacting property changes and creates Property Change records for reassessment tracking.</description>
    <environments>Default</environments>
    <interviewLabel>Property Tax Impact Detection {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Property Tax Impact Detection</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreatePropertyChange</name>
        <label>Create Property Change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Change_Status__c</field>
            <value>
                <stringValue>Detected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Change_Type__c</field>
            <value>
                <stringValue>Multiple Changes</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>New_Built_up_Area__c</field>
            <value>
                <elementReference>$Record.Built_up_Area__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>New_Floors__c</field>
            <value>
                <elementReference>$Record.Number_of_Floors__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Built_up_Area__c</field>
            <value>
                <elementReference>$Record__Prior.Built_up_Area__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Floors__c</field>
            <value>
                <elementReference>$Record__Prior.Number_of_Floors__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Property__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reassessment_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tax_Impact__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Property_Change__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Tax_Impacting_Change</targetReference>
        </connector>
        <object>Property__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
